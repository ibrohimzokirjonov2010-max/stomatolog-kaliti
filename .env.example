NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_telegram_bot_username
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
STOMAHUB_DB_SECRET=server-only-random-hex
STOMAHUB_SESSION_SECRET=server-only-random-hex
ADMIN_PHONES=+998901234567,+998991112233
ADMIN_EMAILS=ceo@example.com
ADMIN_TELEGRAM_IDS=123456789

# Telegram Login Widget button on /kirish and /royxat. Keep OFF until the bot domain is set in @BotFather
# (/setdomain -> bot -> your domain); otherwise the widget shows "Bot domain invalid".
NEXT_PUBLIC_TELEGRAM_LOGIN_ENABLED=false

# Landing analytics. Leave empty to keep the scripts off.
# Yandex: numeric counter id. Create a JavaScript goal named "lead".
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Meta Events Manager pixel id (digits only).
NEXT_PUBLIC_META_PIXEL_ID=
# GA4 measurement id, for example G-XXXXXXXX.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Microsoft Clarity project id.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
